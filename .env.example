# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running the pipeline.
# NEVER commit .env to source control — it contains credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS credentials ───────────────────────────────────────────────────────────
# Alternatively, run `aws configure` once and leave these blank.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ── Kinesis ───────────────────────────────────────────────────────────────────
# 1 shard = 1 MB/s write, 2 MB/s read — sufficient for this project's TPS
KINESIS_STREAM_NAME=live-transactions
KINESIS_SHARD_COUNT=1

# ── DynamoDB ──────────────────────────────────────────────────────────────────
DYNAMODB_ANOMALIES_TABLE=transaction_anomalies

# ── S3 ────────────────────────────────────────────────────────────────────────
# Bucket names must be globally unique — add your name/initials as a suffix.
S3_BUCKET=live-transactions-cold-yourname-2026

# ── Spark Checkpointing ───────────────────────────────────────────────────────
# Local path for development; switch to s3a://... for production.
CHECKPOINT_LOCATION=/tmp/live-transactions-checkpoint

# ── Anomaly Detection Thresholds ─────────────────────────────────────────────
# Flag any single transaction above this USD amount
ANOMALY_AMOUNT_THRESHOLD=2000.0
# Flag if a user makes more than this many transactions in a 1-minute window
HIGH_FREQUENCY_THRESHOLD=3

# ── Generator ─────────────────────────────────────────────────────────────────
# Seconds to sleep between transactions (0.5 = 2 TPS)
GENERATOR_INTERVAL_SECONDS=0.5
# Fraction of transactions that are intentionally anomalous (~5%)
ANOMALY_RATE=0.05
